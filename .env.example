# ── UTAR SRC Voting System — Environment Variables ──────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# ── Server ───────────────────────────────────────────────────────
PORT=3000

# ── Database (MySQL) ─────────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=utar_src_voting

# ── Blockchain ───────────────────────────────────────────────────
# Ganache local RPC URL (default)
RPC_URL=http://127.0.0.1:7545

# The FIRST Ganache account private key (deployer/admin)
# Copy from Ganache UI → Accounts → Key icon
ADMIN_PRIVATE_KEY=0xYOUR_GANACHE_PRIVATE_KEY_HERE
