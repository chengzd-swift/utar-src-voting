# Environment variables (contains DB password + private key)
.env

# Node modules (too large, reinstalled with npm install)
node_modules/

# Hardhat build artifacts (regenerated by compile)
artifacts/
cache/
typechain-types/

# Contract deployment info (regenerated by deploy.js)
backend/contract.json
frontend/contract.json

# OS junk
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
# Local editor / Claude Code preview config
.claude/
